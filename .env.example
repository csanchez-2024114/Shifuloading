# Obligatoria
OPENAI_API_KEY=sk-...

# Modelo (ID oficial confirmado en developers.openai.com)
LLM_MODEL=gpt-6-luna

# MongoDB local, o Atlas: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=assistant

# Límites de autonomía. MAX_TOKENS: 0 = sin tope.
# MODEL_CALL_LIMIT: 0 = automático según el esfuerzo del mensaje (bajo 5 / medio 15 / alto 40 llamadas); >0 = tope fijo.
MAX_TOKENS=0
RECURSION_LIMIT=100
MODEL_CALL_LIMIT=0

# Búsqueda semántica de recuerdos (Atlas Vector Search + embeddings text-embedding-3-small).
# Con MongoDB local se ignora y se usa búsqueda por palabras.
MEMORY_SEMANTIC=0
# Puntuación mínima (0-1, escala de Atlas) para que un recuerdo cuente como relevante en la búsqueda semántica.
# Calibrado en 0.68 (ver README). Más alto = más "no tengo ese dato"; más bajo = más recuerdos sin relación.
# Recuerdos guardados antes de activar MEMORY_SEMANTIC: indexarlos con scripts/migrate_memories.py (ver README).
MEMORY_MIN_SCORE=0.68

# Resumen de conversaciones largas (solo agente normal, no bigtool): al pasar SUMMARY_TRIGGER_TOKENS
# (tokens aprox. de la conversación), los mensajes viejos se reemplazan por un resumen y se conservan
# sin resumir los últimos SUMMARY_KEEP_MESSAGES. Cada resumen es una llamada extra al modelo.
MEMORY_SUMMARIZE=0
SUMMARY_TRIGGER_TOKENS=12000
SUMMARY_KEEP_MESSAGES=20
# Antes de guardar un recuerdo, una llamada barata comprueba que el usuario lo dijo (si no, no se guarda)
MEMORY_VERIFY=0
# Tras una respuesta que usó búsqueda web, una llamada barata contrasta cada dato con lo recuperado
# y corrige si hace falta (la UI muestra la original). Sin búsqueda en el turno no cuesta nada.
ANSWER_VERIFY=0

# Activa la herramienta de ejemplo que pide aprobación humana antes de ejecutarse
ENABLE_HITL_DEMO=0

# Agente alterno con langgraph-bigtool (opcional, desactivado): el modelo busca las herramientas en un
# índice semántico (retrieve_tools) en vez de recibirlas todas. Conviene con decenas de herramientas.
# Incluye 31 herramientas extra (conversiones, fechas, finanzas, clima, Wikipedia, utilidades...).
USE_BIGTOOL=0
# +58 herramientas inofensivas de demostración (math y texto) para probar con muchas herramientas (95 en total)
BIGTOOL_DEMO_TOOLS=0
# Modelo de embeddings de OpenAI para el índice de herramientas (en memoria, se crea al arrancar)
EMBEDDING_MODEL=text-embedding-3-small

# LangSmith (opcional, desactivado). Con LANGSMITH_TRACING=true las trazas (mensajes, respuestas,
# resultados de herramientas y recuerdos) se ENVÍAN A LA NUBE de LangSmith. Ver README.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-0
# Solo cuentas en la región EU (sin "/" al final):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
