# Obligatoria
OPENAI_API_KEY=sk-...

# Modelo (ID oficial confirmado en developers.openai.com)
LLM_MODEL=gpt-6-luna

# MongoDB local, o Atlas: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=assistant

# Límites de autonomía. MAX_TOKENS: 0 = sin tope.
# MODEL_CALL_LIMIT: 0 = automático según el esfuerzo del mensaje (bajo 5 / medio 15 / alto 40 llamadas); >0 = tope fijo.
MAX_TOKENS=0
RECURSION_LIMIT=100
MODEL_CALL_LIMIT=0

# Búsqueda semántica de recuerdos (Atlas Vector Search + embeddings text-embedding-3-small).
# Con MongoDB local se ignora y se usa búsqueda por palabras.
MEMORY_SEMANTIC=0

# Activa la herramienta de ejemplo que pide aprobación humana antes de ejecutarse
ENABLE_HITL_DEMO=0
