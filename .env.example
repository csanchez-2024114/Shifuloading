# Obligatoria
OPENAI_API_KEY=sk-...

# Modelo (ID oficial confirmado en developers.openai.com)
LLM_MODEL=gpt-6-luna

# MongoDB local, o Atlas: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=assistant

# Límites de autonomía. MAX_TOKENS: tope de salida por llamada; el razonamiento interno cuenta dentro de él
# (con 2000 y esfuerzo alto, el razonamiento lo agotó y la respuesta salió vacía). 0 = sin tope.
# MODEL_CALL_LIMIT: 0 = automático según el esfuerzo del mensaje (bajo 5 / medio 15 / alto EFFORT_HIGH_MAX_CALLS
# llamadas); >0 = tope fijo. Los mensajes cortos sin dígitos, operadores, código ni palabras como calcula, resuelve,
# plan o código no pasan por el clasificador (esfuerzo bajo). El selector de Ajustes de la interfaz manda sobre todo esto.
MAX_TOKENS=8000
RECURSION_LIMIT=100
MODEL_CALL_LIMIT=0
# Tope de llamadas al modelo con esfuerzo alto. La última llamada permitida va sin herramientas: responde con lo que tiene.
EFFORT_HIGH_MAX_CALLS=15
# MAX_TOKENS efectivo con esfuerzo alto (el razonamiento cuenta dentro): con 8000 el razonamiento se comió casi todo y
# el código salió cortado a la mitad. Solo sube el tope (si MAX_TOKENS es mayor o 0, se respeta el tuyo).
EFFORT_HIGH_MAX_TOKENS=12000
# Veces que una misma herramienta puede usarse en un mensaje (las siguientes no se ejecutan); 0 = sin tope.
TOOL_REPEAT_LIMIT=8

# Investigador profundo. MAX_TOKENS no se le aplica: usa su propio tope de salida (0 = sin tope).
INVESTIGATOR_MAX_TOKENS=6000
# Búsquedas por investigación.
INVESTIGATOR_MAX_SEARCHES=4
# Tokens (entrada+salida) de búsquedas web por mensaje: lo comparten el investigador y web_search del agente.
# Cada búsqueda hospedada cuesta de 8k a 51k tokens de entrada (cuenta las páginas leídas).
INVESTIGATOR_TOKEN_BUDGET=120000
# Búsquedas web por mensaje, sumando agente e investigador (el investigador además tiene su propio máximo).
TURN_MAX_SEARCHES=6
# Tokens que se reservan antes de cada búsqueda: no se lanza si con ellos se pasaría el presupuesto o el tope.
SEARCH_COST_ESTIMATE=15000
# Tope general por mensaje: tokens (entrada+salida) de TODAS las llamadas al modelo. Al 80% (o si el historial ya
# pesa más que el tope) se responde sin herramientas ni ANSWER_VERIFY; la respuesta final siempre se permite y puede
# pasarlo por una llamada. Si se cruza sin aterrizar, se aborta con un aviso. 0 = sin tope.
# Debe superar lo que pesan solos el prompt del sistema y las herramientas (~2.3k medidos, ~2.9k estimados): el log avisa al arrancar.
TURN_TOKEN_CAP=150000

# web_search hospedado de OpenAI. SEARCH_CONTEXT_SIZE: low/medium/high (contenido que recupera).
# SEARCH_MAX_TOOL_CALLS: búsquedas internas por llamada (max_tool_calls de la API); 0 = sin tope.
# Medido (una búsqueda, misma pregunta, max_tool_calls=1): low 13.0k, medium 12.8k, high 13.0k tokens de entrada,
# con citas equivalentes en low y medium. Sin max_tool_calls, una búsqueda llegó a 51k (hizo varias internas).
SEARCH_CONTEXT_SIZE=low
SEARCH_MAX_TOOL_CALLS=1

# Comentario SSE ": ping" cada N segundos sin eventos (mantiene viva la conexión detrás de proxies); 0 = apagado.
SSE_PING_SECONDS=15

# Búsqueda semántica de recuerdos (Atlas Vector Search + embeddings text-embedding-3-small).
# Con MongoDB local se ignora y se usa búsqueda por palabras.
MEMORY_SEMANTIC=0
# Puntuación mínima (0-1, escala de Atlas) para que un recuerdo cuente como relevante en la búsqueda semántica.
# Calibrado en 0.68 (ver README). Más alto = más "no tengo ese dato"; más bajo = más recuerdos sin relación.
# Recuerdos guardados antes de activar MEMORY_SEMANTIC: indexarlos con scripts/migrate_memories.py (ver README).
MEMORY_MIN_SCORE=0.68

# Compactación de conversaciones largas (solo agente normal, no bigtool): al pasar COMPACT_TRIGGER_PCT de la
# ventana (CONTEXT_WINDOW_TOKENS), los mensajes viejos se reemplazan por un resumen y se conservan sin resumir
# los más recientes (COMPACT_KEEP_TOKENS, o COMPACT_KEEP_PCT de la ventana). Como mucho una compactación por
# mensaje; cada una es una llamada extra al modelo. El medidor de la interfaz se ve siempre.
MEMORY_SUMMARIZE=0
# Ventana del modelo; vacío = la del perfil del modelo en langchain (gpt-6-luna: 1050000), o 128000 si no tiene
CONTEXT_WINDOW_TOKENS=
COMPACT_WARN_PCT=70
COMPACT_TRIGGER_PCT=85
COMPACT_KEEP_TOKENS=0
COMPACT_KEEP_PCT=20
# Modo anterior: si defines SUMMARY_TRIGGER_TOKENS, el umbral son tokens de los mensajes (sin prompt ni
# herramientas) y se ignora COMPACT_TRIGGER_PCT. SUMMARY_KEEP_TOKENS manda sobre COMPACT_KEEP_*.
# SUMMARY_TRIGGER_TOKENS=12000
# SUMMARY_KEEP_TOKENS=5000
# Capa 1: poda de resultados viejos de herramientas en lo que ve el modelo (el historial guardado no cambia)
COMPACT_PRUNE_TOOLS=0
COMPACT_PRUNE_AGE=6
# Capa 2: resumen estructurado (USER FACTS, DECISIONS AND PREFERENCES, TASKS DONE, OPEN ITEMS, CONTEXT) e incremental
COMPACT_STRUCTURED=0
COMPACT_SUMMARY_MAX_TOKENS=1200
# Modelo del resumen; vacío = LLM_MODEL
COMPACT_MODEL=
# Memoria global: strict = solo datos puntuales del usuario (lo pide, dato personal durable o evento con fecha);
# broad = política anterior. Máximo de recuerdos por mensaje (0 = sin tope)
MEMORY_SAVE_POLICY=strict
MEMORY_MAX_PER_TURN=3
# Antes de guardar un recuerdo, una llamada barata comprueba que el usuario lo dijo (si no, no se guarda)
MEMORY_VERIFY=0
# Tras una respuesta que usó búsqueda web, una llamada barata contrasta cada dato con lo recuperado
# y corrige si hace falta (la UI muestra la original). Sin búsqueda en el turno no cuesta nada.
ANSWER_VERIFY=0

# Activa la herramienta de ejemplo que pide aprobación humana antes de ejecutarse
ENABLE_HITL_DEMO=0

# Agente alterno con langgraph-bigtool (opcional, desactivado): el modelo busca las herramientas en un
# índice semántico (retrieve_tools) en vez de recibirlas todas. Conviene con decenas de herramientas.
# Incluye 31 herramientas extra (conversiones, fechas, finanzas, clima, Wikipedia, utilidades...).
USE_BIGTOOL=0
# +58 herramientas inofensivas de demostración (math y texto) para probar con muchas herramientas (95 en total)
BIGTOOL_DEMO_TOOLS=0
# Modelo de embeddings de OpenAI para el índice de herramientas (en memoria, se crea al arrancar)
EMBEDDING_MODEL=text-embedding-3-small

# LangSmith (opcional, desactivado). Con LANGSMITH_TRACING=true las trazas (mensajes, respuestas,
# resultados de herramientas y recuerdos) se ENVÍAN A LA NUBE de LangSmith. Ver README.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-0
# Solo cuentas en la región EU (sin "/" al final):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
