# Configuración de Flask
FLASK_SECRET_KEY=1111

# JWT: vigencia del access token en minutos (default recomendado: 480 = 8 horas)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS: lista adicional de orígenes permitidos, separados por coma (sin espacios entre ellos)
# Se SUMA al listado base seguro definido en Config (no lo reemplaza)
# Ejemplo completo:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://hypershifu.com,https://www.hypershifu.com,https://hyper-shifu-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://hypershifu.com,https://www.hypershifu.com,https://hyper-shifu-frontend.onrender.com
# Opcional: regex para autorizar subdominios completos
# Ejemplo: ^https://([a-z0-9-]+\.)?onrender\.com$
CORS_ALLOWED_ORIGIN_REGEX=

# Slack
SLACK_CLIENT_ID=1111
SLACK_CLIENT_SECRET=1111

# Gmail
GMAIL_CLIENT_ID=1111
GMAIL_CLIENT_SECRET=1111
# Notion
NOTION_CLIENT_ID=1111
NOTION_CLIENT_SECRET=1111

# Asana
ASANA_CLIENT_ID=1111
ASANA_CLIENT_SECRET=1111

# Dropbox
DROPBOX_CLIENT_ID=1111
DROPBOX_CLIENT_SECRET=1111

# Outlook
OUTLOOK_CLIENT_ID=1111
OUTLOOK_CLIENT_SECRET=1111

# ─────────────────────────────────────────────────────────────────
# STRIPE — Pagos
# Obtener en: https://dashboard.stripe.com/apikeys
# Usar claves sk_test_REEMPLAZAR / pk_test_... para desarrollo
# ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Webhook secret — se genera al ejecutar el Stripe CLI en local (whsec_REEMPLAZAR)
# En producción se obtiene desde: https://dashboard.stripe.com/webhooks
WEBHOOK_SECRET=whsec_REEMPLAZAR

# (Opcional - legacy) Price IDs de planes fijos. Solo necesario si se usan
# los endpoints legacy /checkout que no usan el catálogo dinámico.
STRIPE_PRICE_PRO=price_XXXXXXXX
STRIPE_PRICE_MASTER=price_XXXXXXXX
STRIPE_PRICE_PREMIUM=price_XXXXXXXX
STRIPE_PRICE_ENTERPRISE=price_XXXXXXXX

# HubSpot
HUBSPOT_CLIENT_ID=1111
HUBSPOT_CLIENT_SECRET=1111

# Salesforce
SALESFORCE_CLIENT_ID=1111
SALESFORCE_CLIENT_SECRET=1111

# ─────────────────────────────────────────────────────────────────
# CLOUDINARY — Gestión de Medios (Opcional)
# Obtener en: https://cloudinary.com/console/settings/account
# ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
