          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w6" edge="1" parent="req" source="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;" target="wc" value="cada turno">
