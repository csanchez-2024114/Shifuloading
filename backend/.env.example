# --- Infra local (Mongo en :27018, Redis en :6380) ---
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=shifu_isolated
REDIS_URL=redis://localhost:6380/0
ENVIRONMENT=development

# --- Seguridad (genera valores NUEVOS, distintos a los del backend original) ---
SECRET_KEY=              # >= 32 chars
ENCRYPTION_KEY=          # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_SALT=
SECRETS_ENCRYPTION_KEY=  # idem Fernet key (vault de secretos del usuario)

# --- LLM / busqueda (deben existir ANTES de importar la app) ---
OPENAI_API_KEY=
CHAT_API_KEY=            # Config.OPENAI_API_KEY lee esta; poner el mismo valor
TAVILY_API_KEY=
SHIFU_AGENT_ID=shifu_v1

# --- URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:5001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- OAuth de apps (llenar solo las que vayas a probar; Google primero) ---
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
GOOGLE_SIGNIN_REDIRECT_URI=
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# ASANA_/DROPBOX_/HUBSPOT_/FACEBOOK_/SLACK_/NOTION_... _CLIENT_ID/_CLIENT_SECRET

# --- Funciones de apps (ver doc/funciones/) ---
# FUNCTIONS_TEST_ENABLED=true   # false apaga /internal/functions (interruptor de emergencia)

# --- Opcional ---
# Donde se guardan los archivos que suben los usuarios: local (carpeta SHIFU_UPLOAD_DIR, por defecto ./uploads) | cloudinary
FILE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Solo desarrollo local (NO activar en un despliegue real) ---
# SHIFU_DEV_UI=1       # sirve la interfaz /ui y deja que el chat devuelva trazas con los prompts completos
# FRONTEND_REDIRECT_URL=http://localhost:5001/ui/   # con la UI de pruebas: el popup de OAuth termina ahi (el redirect_uri de cada app debe estar registrado)
# SHIFU_TRACE_LOG=1    # guarda cada turno completo en logs/agent_traces/ (prompts en texto plano)

# Programador de workflows en el mismo proceso: lanza las tareas de `scheduled_tasks` que ya vencieron.
# Sin SHIFU_SCHEDULER=1 ningun workflow programado corre solo (el webhook y "ejecutar ahora" no lo necesitan).
# SHIFU_SCHEDULER=1
# En produccion conviene correrlo aparte (python -m app.workers.scheduler_loop) y dejar el servidor sin esta variable:
# asi reiniciar el servidor web no detiene workflows programados, vigilante de correo ni recordatorios.
# SHIFU_SCHEDULER_TICK_SECONDS=30   # cada cuanto revisa tareas vencidas
# SMTP de la plataforma (recuperar contrasena y avisos por correo): SMTP_HOST, SMTP_PORT (465 = SSL), SMTP_USER, SMTP_PASS, SMTP_FROM_EMAIL
# SHIFU_NOTICE_EMAILS=1             # manda por correo (SMTP_*) los avisos de workflow fallido, disparador detenido y compromiso que vence; apagado por defecto
# SHIFU_NOTICE_EMAIL_DAILY_CAP=5     # tope de correos de aviso por usuario en 24 h
# SHIFU_EMAIL_POLL_SECONDS=120      # cada cuanto busca correos nuevos para los workflows que arrancan con un correo (minimo 5)
# SHIFU_FUNCTIONS_SIMULATE=1        # los pasos con funciones devuelven el ejemplo de su ficha y no tocan ninguna app

# Limites por IP de /auth (slowapi). false SOLO en local para correr scripts/eval_agent.py (un usuario por conversacion).
RATE_LIMIT_ENABLED=true
# IPs de tu balanceador/proxy (coma). Solo desde ellas se cree X-Forwarded-For; vacio = se usa la IP de la conexion.
TRUSTED_PROXY_IPS=
# Correos con acceso al panel /ui/metrics.html (coma). Vacio + SHIFU_DEV_UI=1 = cualquier usuario logueado (solo local).
ADMIN_EMAILS=
