 "herramientas": [
  {
   "type": "function",
   "function": {
    "name": "abrir_toma",
    "description": "Abre la toma de requerimientos cuando la persona pide DISEÑAR o REHACER la pantalla de inicio o un CRM completo. NO uses esto para cambios puntuales (mover, achicar, un solo bloque): esos van directo con las herramientas de pantalla.",
    "parameters": {
     "type": "object",
     "properties": {
      "objetivo": {
       "type": "string",
       "description": "solo si lo dijo en este mensaje"
      }
     },
     "required": []
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "anotar_bloque",
    "description": "FICHA DE DISEÑO: anota UN bloque que la persona pidió en ESTE mensaje, dicho en simple. que = resumen | grafica | lista | tablero | por_vencer | agenda; seccion = la parte del menú (nombre). grafico = tipo opcional SOLO si lo nombró (dona, barras, columnas, linea…). Llama una vez por cada cosa que pidió. No preguntes detalles técnicos: el código elige lo razonable.",
    "parameters": {
     "type": "object",
     "properties": {
      "que": {
       "type": "string",
       "enum": [
        "resumen",
        "grafica",
        "lista",
        "tablero",
        "por_vencer",
        "agenda"
       ]
      },
      "seccion": {
       "type": "string"
      },
      "grafico": {
       "type": "string"
      }
     },
     "required": [
      "que",
      "seccion"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "quitar_de_ficha",
    "description": "Quita de la ficha el bloque número N (como aparece en el resumen) cuando la persona lo pide.",
    "parameters": {
     "type": "object",
     "properties": {
      "numero": {
       "type": "integer",
       "minimum": 1
      }
     },
     "required": [
      "numero"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "anotar_ficha",
    "description": "Anota en la ficha de diseño UN dato que la persona dijo explícitamente en ESTE mensaje (nunca inventes ni completes). Si dudas, usa anotar_nota. Campos: objetivo, seccion, bloque {vista, seccion, opciones?, tamano?}, marca_primario, marca_secundario, tipografia, restriccion.",
    "parameters": {
     "type": "object",
     "properties": {
      "campo": {
       "type": "string"
      },
      "valor": {
       "description": "string u objeto según el campo"
      }
     },
     "required": [
      "campo",
      "valor"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "anotar_nota",
    "description": "Guarda una idea o duda que la persona mencionó pero que no es un dato firme de la ficha.",
    "parameters": {
     "type": "object",
     "properties": {
      "texto": {
       "type": "string"
      }
     },
     "required": [
      "texto"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "cerrar_toma",
    "description": "Cierra la toma si la persona abandona el diseño o ya no quiere seguir con la ficha.",
    "parameters": {
     "type": "object",
     "properties": {},
     "required": []
    }
   }
  }
 ],
